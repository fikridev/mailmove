# MailMove environment. On the VPS: /etc/mailmove/mailmove.env (root:mailmove, mode 0640).
# Locally: copy to .env (gitignored). Never commit a real key.

# Fernet key for stored mailbox passwords. Generate: python scripts/init_db.py --gen-key
# Losing it means stored passwords cannot be decrypted (re-enter them in a new job).
MAILMOVE_KEY=

# SQLite database (metadata + checkpoints only, never email content)
MAILMOVE_DB=/var/lib/mailmove/data/mailmove.db

# Optional tuning (defaults shown)
# MAILMOVE_IMAP_TIMEOUT=30        # seconds per IMAP connect/read/write
# MAILMOVE_BACKOFF_BASE=5         # first retry delay, doubles each time
# MAILMOVE_BACKOFF_MAX=300        # retry delay cap (5 minutes)
# MAILMOVE_MAX_MESSAGE_MB=150     # refuse single emails bigger than this (held in RAM while copying)
# MAILMOVE_HEARTBEAT_STALE=60
